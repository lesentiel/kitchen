{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [
			"vite/client",
			"@cloudflare/vitest-pool-workers/types"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"src",
		"test",
		"cloudflare.config.ts",
		"vitest.config.ts",
		".cloudflare/types"
	]
}
